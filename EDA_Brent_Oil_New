    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "import matplotlib.ticker as mticker\n",
    "from matplotlib.backends.backend_pdf import PdfPages\n",
    "from scipy.stats import gaussian_kde\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# ── Load ──────────────────────────────────────────────────────────────────────\n",
    "df = pd.read_csv(\"/kaggle/input/datasets/siddhant22132/sfheagrw/Brent Oil.csv\")\n",
    "df[\"Date\"] = pd.to_datetime(df[\"Date\"], dayfirst=False)   # format: MM/01/YYYY\n",
    "df = df.sort_values(\"Date\").reset_index(drop=True)\n",
    "\n",
    "# ── Feature engineering ───────────────────────────────────────────────────────\n",
    "df[\"Year\"]           = df[\"Date\"].dt.year\n",
    "df[\"Month\"]          = df[\"Date\"].dt.month\n",
    "df[\"Decade\"]         = (df[\"Year\"] // 10 * 10).astype(str) + \"s\"\n",
    "df[\"MoM_Return\"]     = df[\"Value\"].pct_change() * 100        # month-on-month %\n",
    "df[\"YoY_Return\"]     = df[\"Value\"].pct_change(12) * 100      # year-on-year %\n",
    "df[\"Volatility_12M\"] = df[\"MoM_Return\"].rolling(12).std()    # 12-month rolling std\n",
    "df[\"MA6\"]            = df[\"Value\"].rolling(6,  min_periods=1).mean()\n",
    "df[\"MA12\"]           = df[\"Value\"].rolling(12, min_periods=1).mean()\n",
    "df[\"Rolling_Max\"]    = df[\"Value\"].cummax()\n",
    "df[\"Drawdown\"]       = (df[\"Value\"] - df[\"Rolling_Max\"]) / df[\"Rolling_Max\"] * 100\n",
    "\n",
    "print(f\"Rows  : {len(df)}\")\n",
    "print(f\"Range : {df['Date'].min().date()}  →  {df['Date'].max().date()}\")\n",
    "print(f\"Cols  : {list(df.columns)}\")\n",
    "df.head()\n"
   ]
  },
